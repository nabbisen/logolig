[Desktop Entry]
Type=Application
Name=Logolig
Comment=Make favicons and app logos from one image, offline
Comment[ja]=1枚の画像から favicon とアプリ用ロゴを作成（オフライン）
Exec=logolig
Icon=io.github.nabbisen.Logolig
Terminal=false
Categories=Graphics;
Keywords=favicon;icon;logo;ico;webmanifest;
Keywords[ja]=ファビコン;アイコン;ロゴ;
# The window's Wayland app_id and X11 WM_CLASS (crates/app/src/window.rs, RFC 025): the same as the file name.
StartupWMClass=io.github.nabbisen.Logolig
